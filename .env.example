# Copy to .env only if you want a live AI. `.env` holds only the AI_* settings
# and TEST_MODE; every other setting comes from the environment, compose.yaml or
# Vercel. Without an AI key the app runs in Test mode on recorded answers.
# Names only: nothing here carries a value. FEATURE_* flags default in
# config.ts; set one only to override its default.

# APP_ENV
# TEST_MODE
# AI_PROVIDER
# AI_MODEL
# AI_API_KEY
# DATABASE_URL
# SECRETS_FILE
# ENCRYPTION_KEY
# ACCESS_CODE
# FEATURE_ACCOUNTS
# FEATURE_GAPS
# FEATURE_REWORDING
# FEATURE_KEYWORD_FALLBACK
