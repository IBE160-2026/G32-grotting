{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "src/**",
      "e2e/**",
      "test/**",
      "scripts/**",
      "data/**",
      "*.ts",
      "*.mjs",
      "*.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noConsole": "error"
      },
      "style": {
        "noRestrictedImports": "off"
      }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/shared/server/log.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["src/modules/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/modules/*/core",
                      "@/modules/*/core/**",
                      "@/modules/*/server",
                      "@/modules/*/server/**",
                      "@/modules/*/ui/**",
                      "!@/modules/keywords/core",
                      "!@/modules/integrity/core",
                      "!@/modules/*/ui/index",
                      "!@/modules/keywords/core/index",
                      "!@/modules/integrity/core/index"
                    ],
                    "message": "Import another slice only through its index.ts, contracts.ts, ui/index.ts, or core/index.ts (keywords and integrity)."
                  },
                  {
                    "group": ["../../../**"],
                    "message": "A slice file must not reach outside its slice with a relative import; use the @/ alias."
                  },
                  {
                    "group": ["@orama/stemmers", "@orama/stemmers/**"],
                    "message": "Only keywords/core stems or compares words: import it through @/modules/keywords/core."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/app/**", "src/proxy.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/modules/*/core",
                      "@/modules/*/core/**",
                      "@/modules/*/server",
                      "@/modules/*/server/**",
                      "@/modules/*/ui/**",
                      "!@/modules/keywords/core",
                      "!@/modules/integrity/core",
                      "!@/modules/*/ui/index",
                      "!@/modules/keywords/core/index",
                      "!@/modules/integrity/core/index"
                    ],
                    "message": "Import another slice only through its index.ts, contracts.ts, ui/index.ts, or core/index.ts (keywords and integrity)."
                  },
                  {
                    "group": ["@orama/stemmers", "@orama/stemmers/**"],
                    "message": "Only keywords/core stems or compares words: import it through @/modules/keywords/core."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/shared/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/modules/**"],
                    "message": "The shared kernel must not import slices."
                  },
                  {
                    "group": ["@orama/stemmers", "@orama/stemmers/**"],
                    "message": "Only keywords/core stems or compares words: import it through @/modules/keywords/core."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/modules/keywords/core/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**",
                      "!./**",
                      "!../**",
                      "!@/shared/core/**",
                      "!@orama/stemmers/norwegian"
                    ],
                    "message": "keywords/core may import only shared/core, its own slice by relative path, and @orama/stemmers/norwegian."
                  },
                  {
                    "group": [
                      "../**/server",
                      "../**/server/**",
                      "../**/ui",
                      "../**/ui/**",
                      "../**/shared/**",
                      "../**/modules/**",
                      "../**/app/**"
                    ],
                    "message": "keywords/core must not reach server, ui, shared or other slices by a relative import."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/modules/integrity/core/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**",
                      "!./**",
                      "!../**",
                      "!@/shared/core/**",
                      "!@/modules/keywords/core",
                      "!@/modules/keywords/core/index"
                    ],
                    "message": "integrity/core may import only keywords/core, shared/core and its own slice by relative path."
                  },
                  {
                    "group": [
                      "../**/server",
                      "../**/server/**",
                      "../**/ui",
                      "../**/ui/**",
                      "../**/shared/**",
                      "../**/modules/**",
                      "../**/app/**"
                    ],
                    "message": "integrity/core must not reach server, ui, shared or other slices by a relative import."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/shared/core/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**",
                      "!zod",
                      "!./**",
                      "!../**",
                      "!@/shared/core/**"
                    ],
                    "message": "shared/core is pure: it may import only zod, relative paths and itself."
                  },
                  {
                    "group": [
                      "../**/server",
                      "../**/server/**",
                      "../**/ui",
                      "../**/ui/**",
                      "../**/shared/**",
                      "../**/modules/**",
                      "../**/app/**"
                    ],
                    "message": "shared/core must not reach server, ui, shared or other slices by a relative import."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
