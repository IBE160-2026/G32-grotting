{
  "name": "jobassistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "predev": "tsx --conditions=react-server scripts/setup.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "serve": "tsx --conditions=react-server scripts/setup.ts && next start -H 0.0.0.0 -p 3000",
    "lint": "biome check",
    "format": "biome format --write",
    "typegen": "next typegen",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "biome check && next typegen && tsc --noEmit && vitest run && playwright test",
    "db:generate": "drizzle-kit generate",
    "db:check": "tsx --conditions=react-server scripts/db-check.ts",
    "db:migrate": "tsx --conditions=react-server scripts/migrate.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.4.6",
    "drizzle-orm": "0.45.4",
    "next": "16.4.6",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@playwright/test": "1.65.0",
    "@tailwindcss/turbopack": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
